[sub_resource type="GDScript" id="GDScript_epypp"]
script/source = "extends Node

@export var mob_scene: PackedScene
var score


func game_over() -> void: ### <SIGNAL> Connect with \"hit\" signal of Player scene
	$ScoreTimer.stop()
	$MobTimer.stop()
	$HUD.show_game_over()
	$Music.stop()
	$DeathSound.play()
	
func _ready(): ### <SIGNAL> Connect with \"start_game\" signal of HUD scene
	get_tree().call_group(\"mobs\", \"queue_free\")
	score = 0
	print(\"Game Started\")
	

	
